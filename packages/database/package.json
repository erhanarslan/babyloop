{
  "name": "@babyloop/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:check": "drizzle-kit check --config=drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:seed": "pnpm build && node dist/seed.js",
    "e2e:publish-listing": "pnpm build && node dist/e2e-publish-listing.js",
    "test:e2e-publish-listing": "pnpm build && node --test test/e2e-publish-listing.test.mjs",
    "demo:seed:production:plan": "pnpm build && node dist/production-demo-seed.js --plan",
    "demo:seed:production": "pnpm build && node dist/production-demo-seed.js --apply",
    "test:production-demo": "pnpm build && node --test test/production-demo-catalog.test.mjs",
    "backoffice:viewer": "pnpm build && node dist/assign-backoffice-viewer.js",
    "test:backoffice-viewer": "pnpm build && node --test test/backoffice-viewer-role.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    },
    "./production-demo-product-sources": {
      "types": "./dist/production-demo-product-sources.d.ts",
      "import": "./dist/production-demo-product-sources.js"
    }
  },
  "dependencies": {
    "drizzle-orm": "^0.39.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.30.0"
  }
}
