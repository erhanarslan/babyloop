DATABASE_URL=postgresql://postgres:postgres@localhost:5432/babyloop_dev
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/babyloop_test
BABYLOOP_API_BASE_URL=http://localhost:4000
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_BACKOFFICE_BASE_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BABYLOOP_SITE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_SECRET=change-this-local-dev-auth-secret-32chars-min
AUTH_TOKEN_TTL_SECONDS=900
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# noop: auth email delivery is skipped.
# provider: auth email drafts are routed to EMAIL_PROVIDER. Real sending still requires EMAIL_SEND_ENABLED=true.
EMAIL_DELIVERY_MODE=noop
# true enables real SMTP or Resend sending when EMAIL_PROVIDER=smtp|resend.
EMAIL_SEND_ENABLED=false
EMAIL_PROVIDER=mock
EMAIL_FROM=no-reply@babyloop.local
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
WEB_APP_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379
UPLOAD_ROOT=var/uploads

# Runtime readiness and observability.
# /health/live only checks that the process is alive.
# /health/ready performs bounded dependency probes and returns 503 when a required dependency is unavailable.
HEALTH_READINESS_TIMEOUT_MS=3000
HEALTH_REQUIRE_NOTIFICATION_WORKER=false
HEALTH_REQUIRE_CHILD_REMINDER_WORKER=false
HEALTH_FAIL_ON_STALE_NOTIFICATION_CLAIMS=false
NOTIFICATION_WORKER_MAX_STALENESS_SECONDS=900
CHILD_REMINDER_WORKER_MAX_STALENESS_SECONDS=900
# Protected Prometheus metrics endpoint: GET /internal/metrics with Authorization: Bearer <token>.
OBSERVABILITY_METRICS_ENABLED=false
# OBSERVABILITY_METRICS_TOKEN=replace-with-a-long-random-token
OBSERVABILITY_SERVICE_NAME=babyloop-api
OBSERVABILITY_ENVIRONMENT=development
# Optional HTTPS webhook for sanitized runtime error reports. Local HTTP is accepted only outside production.
# OBSERVABILITY_ERROR_WEBHOOK_URL=https://errors.example.com/babyloop
# OBSERVABILITY_ERROR_WEBHOOK_TOKEN=replace-with-provider-token
OBSERVABILITY_ERROR_REPORT_TIMEOUT_MS=2500

# PostgreSQL backup, restore and release rollback operations.
# Production backups must use age encryption and a separate persistent replica directory.
BACKUP_ENVIRONMENT=local
BACKUP_OUTPUT_DIR=var/backups/postgres
# BACKUP_REPLICA_DIR=/mnt/babyloop-backups/postgres
BACKUP_ENCRYPTION_MODE=none
# BACKUP_AGE_RECIPIENT=age1replace-with-public-recipient
# BACKUP_AGE_IDENTITY_FILE=/run/secrets/babyloop-backup-age-key.txt
BACKUP_RETENTION_DAYS=14
BACKUP_RETENTION_COUNT=7
# Deployment evidence identifier or immutable URL recorded after an isolated restore smoke.
# BACKUP_RESTORE_SMOKE_EVIDENCE=restore-smoke-2026-07-20T120000Z
# RELEASE_BACKUP_MANIFEST_PATH=/mnt/babyloop-backups/postgres/latest.dump.age.manifest.json
RELEASE_DATABASE_FORWARD_COMPATIBLE=false

# Notification provider delivery processor.
# child-reminders:process creates candidate logs; notifications:process performs provider attempts.
# Keep disabled unless provider credentials, consent/preference gates, and smoke tests are ready.
CHILD_REMINDER_PROCESSOR_DRY_RUN=true
CHILD_REMINDER_PROCESSOR_LIMIT=50
# CHILD_REMINDER_WORKER_ID=child-reminder-worker-1
# Comma-separated: in_app,email,push,n8n. Default processor behavior remains in_app only.
CHILD_REMINDER_DELIVERY_CHANNELS=in_app
NOTIFICATION_PROVIDER_PROCESS_LIMIT=50
# Unique per worker instance when multiple processors run concurrently. Auto-generated when omitted.
# NOTIFICATION_PROVIDER_WORKER_ID=notification-worker-1
# Claim lease in milliseconds; keep above provider timeout. Runtime enforces timeout + 30s and a 60s minimum.
NOTIFICATION_PROVIDER_CLAIM_TTL_MS=300000

# Notification email provider execution. By default this reuses the Resend settings
# above (EMAIL_SEND_ENABLED, EMAIL_PROVIDER, EMAIL_FROM and RESEND_API_KEY).
# Set the optional values below only when notification email needs a separate switch
# or sender. Schedule `pnpm --filter @babyloop/api notifications:process` for delivery.
# NOTIFICATION_EMAIL_ENABLED=true
# NOTIFICATION_EMAIL_PROVIDER=resend
# RESEND_FROM_EMAIL=no-reply@babyloop.local
RESEND_FROM_NAME=BabyLoop
# RESEND_API_KEY=
# RESEND_API_BASE_URL=https://api.resend.com
# NOTIFICATION_EMAIL_TIMEOUT_MS=3000
# NOTIFICATION_EMAIL_MAX_RETRIES=3
# Explicit production smoke guard. Never keep this enabled after a controlled test.
# NOTIFICATION_MARKETPLACE_SMOKE_CONFIRM_SEND=false
# NOTIFICATION_SMOKE_RECIPIENT_EMAIL=you@example.com

# Notification push provider execution.
NOTIFICATION_PUSH_ENABLED=false
PUSH_PROVIDER=expo
# EXPO_ACCESS_TOKEN=
# EXPO_PUSH_API_BASE_URL=https://exp.host/--/api/v2/push/send
# PUSH_TOKEN_ENCRYPTION_KEY=change-this-push-token-encryption-key-32chars-min
# NOTIFICATION_PUSH_TIMEOUT_MS=3000
# NOTIFICATION_PUSH_MAX_RETRIES=3

# Optional n8n notification provider execution.
N8N_NOTIFICATION_WEBHOOK_ENABLED=false
# N8N_NOTIFICATION_WEBHOOK_URL=
# N8N_NOTIFICATION_WEBHOOK_BEARER_TOKEN=
# N8N_NOTIFICATION_WEBHOOK_SECRET=
# N8N_NOTIFICATION_WEBHOOK_TIMEOUT_MS=3000
# N8N_NOTIFICATION_WEBHOOK_MAX_RETRIES=3

# Future object storage placeholders for migrating local listing images to R2/S3.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
# Cloudflare R2 example: https://<account-id>.r2.cloudflarestorage.com
# Public delivery should use an HTTPS r2.dev or custom Cloudflare domain, not the authenticated S3 endpoint.
# Set true only while running `pnpm --filter @babyloop/api storage:smoke:r2`; the script deletes its temporary object.
IMAGE_STORAGE_R2_SMOKE_ALLOW_WRITE=false
# ALLOW_AUTH_UNAVAILABLE=true is only for local unavailable-mode testing.
# Do not enable it in normal development or production.
ALLOW_AUTH_UNAVAILABLE=false

# AI providers
# Local development can use Gemini by copying this file to .env.local and setting GEMINI_API_KEY there.
# Production should choose providers explicitly per environment.
ASSISTANT_PROVIDER=gemini
AI_LISTING_DRAFT_PROVIDER=gemini
AI_MODERATION_SUMMARY_PROVIDER=gemini

GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_ASSISTANT_MODEL=gemini-2.5-flash-lite
GEMINI_LISTING_DRAFT_MODEL=gemini-2.5-flash
GEMINI_LISTING_IMAGE_AUTHENTICITY_MODEL=gemini-2.5-flash
GEMINI_MODERATION_SUMMARY_MODEL=gemini-2.5-flash-lite
GEMINI_API_ENDPOINT=https://generativelanguage.googleapis.com

# RAG / grounded assistant
RAG_ENABLED=true
RAG_VECTOR_STORE=qdrant
RAG_QDRANT_URL=http://localhost:6333
RAG_QDRANT_API_KEY=
RAG_QDRANT_COLLECTION=babyloop_rag
RAG_QDRANT_VECTOR_SIZE=3072
RAG_EMBEDDING_PROVIDER=gemini
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_CHAT_PROVIDER=gemini
RAG_CHAT_MODEL=gemini-2.5-flash
RAG_MIN_SCORE=0.72
RAG_MAX_CHUNKS=5
RAG_MAX_SOURCES_PER_DOCUMENT=2
RAG_MAX_CONTEXT_CHARS=8000
RAG_REQUIRE_SOURCES=true
RAG_REDIS_ENABLED=false
RAG_REDIS_URL=redis://localhost:6379
RAG_REDIS_KEY_PREFIX=babyloop:rag
RAG_REDIS_CONNECT_TIMEOUT_MS=1000
RAG_CACHE_ENABLED=true
RAG_CACHE_BACKEND=memory
RAG_CACHE_TTL_SECONDS=900
RAG_CACHE_MAX_ENTRIES=200
RAG_USAGE_LIMITS_ENABLED=true
RAG_USAGE_LIMITS_BACKEND=memory
RAG_HOURLY_GUEST_LIMIT=10
RAG_DAILY_GUEST_LIMIT=20
RAG_HOURLY_USER_LIMIT=50
RAG_DAILY_USER_LIMIT=100
RAG_ADMIN_LIMIT_BYPASS=true
RAG_METRICS_ENABLED=true
RAG_METRICS_BACKEND=memory
RAG_LIVE_EVAL_ENABLED=false
RAG_HYBRID_ENABLED=true
RAG_LEXICAL_SCORE_WEIGHT=0.18
RAG_VECTOR_SCORE_WEIGHT=1
RAG_TITLE_MATCH_BONUS=0.04
RAG_SECTION_MATCH_BONUS=0.03
RAG_TOPIC_MATCH_BONUS=0.03
RAG_SOURCE_RELIABILITY_BONUS=0.02
RAG_DUPLICATE_PENALTY=0.05
RAG_NO_SOURCE_MIN_SCORE=0.68
RAG_MIN_SOURCE_COVERAGE=1
RAG_GOVERNANCE_TEXT_PREVIEW_CHARS=280
RAG_PLAYGROUND_ENABLED=true
RAG_EVAL_HISTORY_MAX_RUNS=20
RAG_REINDEX_ACTION_ENABLED=false
ASSISTANT_TOOLS_ENABLED=true
ASSISTANT_MAX_TOOL_CALLS=3
ASSISTANT_TOOL_TIMEOUT_MS=1500

# Optional OpenAI fallback providers. These are used only when the matching provider env is set to openai.
OPENAI_API_KEY=
OPENAI_ASSISTANT_MODEL=gpt-5.4-mini
OPENAI_LISTING_DRAFT_MODEL=gpt-5.4-mini
OPENAI_MODERATION_SUMMARY_MODEL=gpt-5.4-mini
OPENAI_RESPONSES_ENDPOINT=https://api.openai.com/v1/responses

# Listing image storage.
# local: stores under UPLOAD_ROOT and serves through /api/v1/uploads/listings
# s3: stores in an S3/R2 compatible bucket and returns IMAGE_STORAGE_PUBLIC_BASE_URL URLs
IMAGE_STORAGE_DRIVER=local
IMAGE_STORAGE_PUBLIC_BASE_URL=/api/v1/uploads

# Listing image optimization.
# Server-side normalization before writing to local/S3/R2 storage.
IMAGE_OPTIMIZATION_ENABLED=true

LISTING_IMAGE_MAX_DIMENSION=1600

LISTING_IMAGE_JPEG_QUALITY=82

LISTING_IMAGE_MIN_OPTIMIZE_BYTES=122880


# Image proxy cache.
# Keeps optimized R2/S3 listing images in API memory after first read.
IMAGE_PROXY_MEMORY_CACHE_ENABLED=true
IMAGE_PROXY_MEMORY_CACHE_MAX_BYTES=67108864
IMAGE_PROXY_MEMORY_CACHE_MAX_ITEM_BYTES=2097152


# Listing image authenticity gate.
# Production must use gemini. Mock is local/test only and is rejected in production.
LISTING_IMAGE_AUTHENTICITY_PROVIDER=gemini
LISTING_IMAGE_AUTHENTICITY_TIMEOUT_MS=8000

# Local mobile approval push smoke
NOTIFICATION_PUSH_ENABLED=true
PUSH_PROVIDER=expo
EXPO_ACCESS_TOKEN=
