{
  "name": "babyloop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "dev": "turbo dev --filter=@babyloop/web --filter=@babyloop/api",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d",
    "dev:infra:down": "docker compose -f docker-compose.dev.yml down",
    "dev:infra:reset": "docker compose -f docker-compose.dev.yml down -v",
    "build": "turbo build",
    "preflight": "node scripts/check-tooling.mjs",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "validate": "pnpm preflight && pnpm typecheck && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "turbo": "^2.8.0",
    "typescript": "^5.9.0"
  }
}
