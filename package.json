{
  "name": "babyloop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "dev": "turbo dev --filter=@babyloop/web --filter=@babyloop/api",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d",
    "dev:infra:down": "docker compose -f docker-compose.dev.yml down",
    "dev:infra:reset": "docker compose -f docker-compose.dev.yml down -v",
    "build": "turbo build",
    "preflight": "node scripts/check-tooling.mjs",
    "test": "turbo run test",
    "test:api": "pnpm --filter @babyloop/api test",
    "test:web": "pnpm --filter @babyloop/web test",
    "test:backoffice": "pnpm --filter @babyloop/backoffice test",
    "test:mobile": "pnpm --filter @babyloop/mobile test",
    "test:e2e:web": "pnpm --filter @babyloop/web test:e2e",
    "test:e2e:backoffice": "pnpm --filter @babyloop/backoffice test:e2e",
    "test:e2e:mobile": "pnpm --filter @babyloop/mobile test:e2e",
    "test:ui": "pnpm --filter @babyloop/web test && pnpm --filter @babyloop/backoffice test && pnpm --filter @babyloop/mobile test",
    "typecheck": "turbo typecheck",
    "validate": "pnpm preflight && pnpm typecheck && pnpm build && pnpm test",
    "e2e:web:full-flow:guarded": "mkdir -p .e2e-results && WEB_E2E_FULL_FLOW=1 WEB_E2E_BASE_URL=http://localhost:3000 WEB_E2E_API_BASE_URL=http://127.0.0.1:4000 pnpm --filter @babyloop/web exec playwright test --reporter=json --workers=1 > .e2e-results/web-full-flow.json && node scripts/assert-playwright-no-skips.mjs .e2e-results/web-full-flow.json",
    "e2e:backoffice:guarded": "mkdir -p .e2e-results && BACKOFFICE_E2E_BASE_URL=http://localhost:3001 pnpm --filter @babyloop/backoffice exec playwright test --reporter=json --workers=1 > .e2e-results/backoffice.json && node scripts/assert-playwright-no-skips.mjs .e2e-results/backoffice.json",
    "test:api:security": "node scripts/run-api-test-bundle.mjs security",
    "test:api:trust": "node scripts/run-api-test-bundle.mjs trust",
    "test:api:backoffice": "node scripts/run-api-test-bundle.mjs backoffice",
    "test:api:marketplace": "node scripts/run-api-test-bundle.mjs marketplace",
    "test:e2e:web:auth": "node scripts/run-e2e-test-bundle.mjs web auth",
    "test:e2e:web:marketplace": "node scripts/run-e2e-test-bundle.mjs web marketplace",
    "test:e2e:web:messaging": "node scripts/run-e2e-test-bundle.mjs web messaging",
    "test:e2e:backoffice:trust": "node scripts/run-e2e-test-bundle.mjs backoffice trust",
    "test:e2e:backoffice:ops": "node scripts/run-e2e-test-bundle.mjs backoffice ops",
    "smoke:release": "bash scripts/release-smoke.sh",
    "db:seed": "pnpm --filter @babyloop/database db:seed",
    "demo:seed": "pnpm --filter @babyloop/database db:seed",
    "demo:seed:keep-e2e": "BABYLOOP_SEED_KEEP_E2E_LISTINGS=1 pnpm --filter @babyloop/database db:seed",
    "test:e2e:web:release": "node scripts/run-e2e-test-bundle.mjs web release",
    "test:api:release": "node scripts/run-api-test-bundle.mjs release",
    "test:e2e:backoffice:release": "node scripts/run-e2e-test-bundle.mjs backoffice release",
    "release:artifacts": "node scripts/check-release-artifacts.mjs",
    "release:clean": "node scripts/clean-release-artifacts.mjs",
    "test:web:seo": "pnpm --filter @babyloop/web exec vitest run src/lib/seo.test.ts src/app/robots.test.ts src/app/sitemap.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "turbo": "^2.8.0",
    "typescript": "^5.9.0"
  }
}
