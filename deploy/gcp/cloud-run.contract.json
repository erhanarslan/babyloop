{
  "schemaVersion": 1,
  "topology": "single_environment",
  "region": "europe-west1",
  "schedulerRegion": "europe-west1",
  "repository": "babyloop-images",
  "projects": {
    "staging": "babyloop-staging",
    "production": "babyloop-staging"
  },
  "environments": {
    "staging": {
      "logicalEnvironment": "staging",
      "deployable": false,
      "mode": "ci_rehearsal_only",
      "projectId": "babyloop-staging"
    },
    "production": {
      "logicalEnvironment": "production",
      "deployable": true,
      "projectId": "babyloop-staging",
      "region": "europe-west1",
      "artifactRepository": "babyloop-images",
      "publicDomains": {
        "web": "https://babyloop.com.tr",
        "api": "https://api.babyloop.com.tr",
        "backoffice": "https://admin.babyloop.com.tr"
      }
    }
  },
  "requiredApis": [
    "artifactregistry.googleapis.com",
    "run.googleapis.com",
    "secretmanager.googleapis.com",
    "cloudscheduler.googleapis.com",
    "iam.googleapis.com",
    "cloudresourcemanager.googleapis.com",
    "serviceusage.googleapis.com",
    "logging.googleapis.com"
  ],
  "serviceAccounts": {
    "api": "babyloop-api-runtime",
    "web": "babyloop-web-runtime",
    "backoffice": "babyloop-backoffice-runtime",
    "jobs": "babyloop-jobs-runtime",
    "scheduler": "babyloop-scheduler-invoker"
  },
  "services": {
    "api": {
      "name": "babyloop-api",
      "image": "api",
      "cpu": "1",
      "memory": "1Gi",
      "concurrency": 40,
      "timeout": "3600s",
      "minInstances": 0,
      "maxInstances": 1,
      "public": true
    },
    "web": {
      "name": "babyloop-web",
      "image": "web",
      "cpu": "1",
      "memory": "512Mi",
      "concurrency": 80,
      "timeout": "300s",
      "minInstances": 0,
      "maxInstances": 1,
      "public": true
    },
    "backoffice": {
      "name": "babyloop-backoffice",
      "image": "backoffice",
      "cpu": "1",
      "memory": "512Mi",
      "concurrency": 40,
      "timeout": "300s",
      "minInstances": 0,
      "maxInstances": 1,
      "public": true
    }
  },
  "jobs": {
    "migrate": {
      "name": "babyloop-migrate",
      "script": "dist/scripts/migrate-database.js",
      "memory": "512Mi",
      "cpu": "1",
      "timeout": "900s",
      "maxRetries": 0
    },
    "notification": {
      "name": "babyloop-notification-worker",
      "script": "dist/scripts/process-notification-deliveries.js",
      "memory": "512Mi",
      "cpu": "1",
      "timeout": "300s",
      "maxRetries": 1,
      "schedule": "*/5 * * * *"
    },
    "childReminder": {
      "name": "babyloop-child-reminder-worker",
      "script": "dist/scripts/process-child-reminders.js",
      "memory": "512Mi",
      "cpu": "1",
      "timeout": "300s",
      "maxRetries": 1,
      "schedule": "*/5 * * * *"
    }
  },
  "timezone": "Europe/Istanbul",
  "secretPrefix": "babyloop",
  "artifactDirectory": ".babyloop-gcp"
}
