DEPLOY_ENVIRONMENT=staging
DEPLOY_ACCEPTANCE_SAMPLES=3
DEPLOY_ACCEPTANCE_MAX_P95_MS=4000
DEPLOY_ACCEPTANCE_MAX_HTML_BYTES=2000000
DEPLOY_ACCEPTANCE_MAX_JSON_BYTES=750000
DEPLOY_ACCEPTANCE_ENFORCE_PERFORMANCE=false
DEPLOY_ACCEPTANCE_EVIDENCE_PATH=/var/lib/babyloop/evidence/staging-acceptance.json
GO_NO_GO_MAX_AGE_HOURS=72
NODE_ENV=production
API_HOST=0.0.0.0
PORT=4000
DATABASE_URL=postgresql://REPLACE_WITH_STAGING_DATABASE
AUTH_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
ALLOW_AUTH_UNAVAILABLE=false
WEB_APP_URL=https://staging.babyloop.example
CORS_ORIGINS=https://staging.babyloop.example,https://admin.staging.babyloop.example
NEXT_PUBLIC_API_BASE_URL=https://api.staging.babyloop.example
BABYLOOP_API_BASE_URL=https://api.staging.babyloop.example
NEXT_PUBLIC_SITE_URL=https://staging.babyloop.example
BABYLOOP_SITE_URL=https://staging.babyloop.example
NEXT_PUBLIC_BACKOFFICE_BASE_URL=https://admin.staging.babyloop.example
EXPO_PUBLIC_WEB_BASE_URL=https://staging.babyloop.example
NEXT_PUBLIC_LEGAL_OPERATOR_NAME=REPLACE_WITH_OPERATOR_NAME
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=REPLACE_WITH_PUBLIC_EMAIL
NEXT_PUBLIC_LEGAL_CONTACT_ADDRESS=REPLACE_WITH_PUBLIC_APPLICATION_ADDRESS
IMAGE_STORAGE_DRIVER=s3
IMAGE_STORAGE_PUBLIC_BASE_URL=https://cdn.staging.babyloop.example
S3_ENDPOINT=https://REPLACE_WITH_R2_ENDPOINT
S3_REGION=auto
S3_BUCKET=REPLACE_WITH_STAGING_BUCKET
S3_ACCESS_KEY_ID=REPLACE_WITH_SECRET_MANAGER_VALUE
S3_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_MANAGER_VALUE
S3_FORCE_PATH_STYLE=false
RAG_ENABLED=true
RAG_VECTOR_STORE=qdrant
RAG_QDRANT_URL=https://REPLACE_WITH_STAGING_QDRANT
RAG_QDRANT_API_KEY=REPLACE_WITH_SECRET_MANAGER_VALUE
RAG_QDRANT_COLLECTION=babyloop_rag_active
RAG_QDRANT_VECTOR_SIZE=3072
RAG_EMBEDDING_PROVIDER=gemini
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_CHAT_PROVIDER=gemini
RAG_CHAT_MODEL=gemini-2.5-flash
RAG_REQUIRE_SOURCES=true
RAG_REDIS_ENABLED=true
RAG_REDIS_URL=rediss://REPLACE_WITH_STAGING_REDIS
RAG_CACHE_BACKEND=redis
RAG_USAGE_LIMITS_BACKEND=redis
RAG_METRICS_BACKEND=redis
GEMINI_API_KEY=REPLACE_WITH_SECRET_MANAGER_VALUE
GEMINI_ASSISTANT_MODEL=gemini-2.5-flash-lite
GEMINI_LISTING_DRAFT_MODEL=gemini-2.5-flash
GEMINI_MODERATION_SUMMARY_MODEL=gemini-2.5-flash-lite
GEMINI_LISTING_IMAGE_AUTHENTICITY_MODEL=gemini-2.5-flash
LISTING_IMAGE_AUTHENTICITY_PROVIDER=gemini
EMAIL_DELIVERY_MODE=provider
EMAIL_SEND_ENABLED=true
EMAIL_PROVIDER=resend
EMAIL_FROM=no-reply@REPLACE_WITH_VERIFIED_DOMAIN
RESEND_API_KEY=REPLACE_WITH_SECRET_MANAGER_VALUE
RESEND_FROM_EMAIL=no-reply@REPLACE_WITH_VERIFIED_DOMAIN
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_EMAIL_PROVIDER=resend
ASSISTANT_PROVIDER=gemini
AI_LISTING_DRAFT_PROVIDER=gemini
AI_MODERATION_SUMMARY_PROVIDER=gemini
OBSERVABILITY_METRICS_ENABLED=true
OBSERVABILITY_METRICS_TOKEN=REPLACE_WITH_RANDOM_METRICS_TOKEN
OBSERVABILITY_ERROR_WEBHOOK_URL=https://REPLACE_WITH_ERROR_SINK
OBSERVABILITY_ENVIRONMENT=staging
HEALTH_REQUIRE_NOTIFICATION_WORKER=true
HEALTH_REQUIRE_CHILD_REMINDER_WORKER=true
HEALTH_FAIL_ON_STALE_NOTIFICATION_CLAIMS=true
NOTIFICATION_WORKER_MAX_STALENESS_SECONDS=300
CHILD_REMINDER_WORKER_MAX_STALENESS_SECONDS=300
NOTIFICATION_PROVIDER_WORKER_ID=staging-notification-worker
CHILD_REMINDER_WORKER_ID=staging-child-reminder-worker
NOTIFICATION_WORKER_INTERVAL_SECONDS=20
CHILD_REMINDER_WORKER_INTERVAL_SECONDS=60
WORKER_FAILURE_BACKOFF_SECONDS=30
CHILD_REMINDER_PROCESSOR_DRY_RUN=false
CHILD_REMINDER_DELIVERY_CHANNELS=in_app,email,push
BACKUP_ENVIRONMENT=staging
BACKUP_OUTPUT_DIR=/var/lib/babyloop/backups
BACKUP_REPLICA_DIR=/mnt/backup-replica
BACKUP_ENCRYPTION_MODE=age
BACKUP_AGE_RECIPIENT=age1REPLACE_WITH_PUBLIC_RECIPIENT
BACKUP_RETENTION_DAYS=14
BACKUP_RETENTION_COUNT=14
BACKUP_RESTORE_SMOKE_EVIDENCE=/var/lib/babyloop/evidence/staging-restore-smoke.json
RELEASE_DATABASE_FORWARD_COMPATIBLE=false
MIGRATION_ENVIRONMENT=staging

# OAuth and real provider delivery
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_SECRET_MANAGER_VALUE
GOOGLE_REDIRECT_URI=https://api.staging.babyloop.example/api/v1/auth/google/callback
RESEND_API_BASE_URL=https://api.resend.com
RESEND_FROM_NAME=BabyLoop
NOTIFICATION_PUSH_ENABLED=true
PUSH_PROVIDER=expo
EXPO_ACCESS_TOKEN=REPLACE_WITH_SECRET_MANAGER_VALUE
EXPO_PUSH_API_BASE_URL=https://exp.host/--/api/v2/push/send
PUSH_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
NOTIFICATION_PUSH_TIMEOUT_MS=5000
NOTIFICATION_PUSH_MAX_RETRIES=3
IMAGE_STORAGE_R2_SMOKE_ALLOW_WRITE=false
NOTIFICATION_SMOKE_RECIPIENT_EMAIL=REPLACE_WITH_STAGING_TEST_EMAIL
NOTIFICATION_SMOKE_EXPO_PUSH_TOKEN=REPLACE_WITH_STAGING_EXPO_PUSH_TOKEN
HEALTH_READINESS_TIMEOUT_MS=5000
RUNTIME_ENV_AUDIT_EVIDENCE_PATH=/var/lib/babyloop/evidence/staging-runtime-env-audit.json
STAGING_BOOTSTRAP_PLAN_PATH=/var/lib/babyloop/evidence/staging-bootstrap-plan.json
PROVIDER_PROBE_EVIDENCE_PATH=/var/lib/babyloop/evidence/staging-provider-probe.json
