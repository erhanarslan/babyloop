# Non-secret release orchestration variables.
# Copy outside the repository, replace every placeholder and chmod 600.
DEPLOY_ENVIRONMENT=staging
DEPLOY_REQUIRE_PUBLIC_SURFACES=false
DEPLOY_ENV_FILE=/etc/babyloop/staging.runtime.env
DEPLOY_COMPOSE_FILE=deploy/compose/docker-compose.runtime.yml
DEPLOY_GIT_SHA=REPLACE_WITH_40_CHARACTER_GIT_SHA
IMAGE_MANIFEST_PATH=/var/lib/babyloop/evidence/container-image-manifest-staging.json
API_BIND_ADDRESS=127.0.0.1
API_BIND_PORT=4000
WEB_BIND_ADDRESS=127.0.0.1
WEB_BIND_PORT=3000
BACKOFFICE_BIND_ADDRESS=127.0.0.1
BACKOFFICE_BIND_PORT=3001
WEB_DOMAIN=staging.babyloop.example
API_DOMAIN=api.staging.babyloop.example
BACKOFFICE_DOMAIN=admin.staging.babyloop.example
TLS_CONTACT_EMAIL=REPLACE_WITH_TLS_CONTACT_EMAIL
RUNTIME_ENV_AUDIT_EVIDENCE_PATH=/var/lib/babyloop/evidence/staging-runtime-env-audit.json
STAGING_BOOTSTRAP_PLAN_PATH=/var/lib/babyloop/evidence/staging-bootstrap-plan.json
PROVIDER_PROBE_EVIDENCE_PATH=/var/lib/babyloop/evidence/staging-provider-probe.json
DEPLOY_ACCEPTANCE_EVIDENCE_PATH=/var/lib/babyloop/evidence/staging-acceptance.json
DEPLOY_RECEIPT_PATH=/var/lib/babyloop/evidence/staging-deployment-receipt.json
