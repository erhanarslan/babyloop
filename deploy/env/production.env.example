DEPLOY_ENVIRONMENT=production
DEPLOY_ACCEPTANCE_SAMPLES=3
DEPLOY_ACCEPTANCE_MAX_P95_MS=2500
DEPLOY_ACCEPTANCE_MAX_HTML_BYTES=2000000
DEPLOY_ACCEPTANCE_MAX_JSON_BYTES=750000
DEPLOY_ACCEPTANCE_ENFORCE_PERFORMANCE=true
DEPLOY_ACCEPTANCE_EVIDENCE_PATH=/var/lib/babyloop/evidence/production-acceptance.json
GO_NO_GO_MAX_AGE_HOURS=72
PRODUCTION_GO_NO_GO_RECEIPT_PATH=/var/lib/babyloop/evidence/production-go.json
NODE_ENV=production
API_HOST=0.0.0.0
PORT=4000
DATABASE_URL=postgresql://REPLACE_WITH_PRODUCTION_DATABASE
AUTH_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
ALLOW_AUTH_UNAVAILABLE=false
WEB_APP_URL=https://babyloop.example
CORS_ORIGINS=https://babyloop.example,https://admin.babyloop.example
NEXT_PUBLIC_API_BASE_URL=https://api.babyloop.example
BABYLOOP_API_BASE_URL=https://api.babyloop.example
NEXT_PUBLIC_SITE_URL=https://babyloop.example
BABYLOOP_SITE_URL=https://babyloop.example
NEXT_PUBLIC_BACKOFFICE_BASE_URL=https://admin.babyloop.example
EXPO_PUBLIC_WEB_BASE_URL=https://babyloop.example
NEXT_PUBLIC_LEGAL_OPERATOR_NAME=REPLACE_WITH_OPERATOR_NAME
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=REPLACE_WITH_PUBLIC_EMAIL
NEXT_PUBLIC_LEGAL_RELEASE_MODE=non_commercial_beta
NEXT_PUBLIC_LEGAL_COMMERCIAL_ACTIVITY_ENABLED=false
NEXT_PUBLIC_LEGAL_PUBLIC_LOCATION=REPLACE_WITH_PUBLIC_CITY_AND_COUNTRY
NEXT_PUBLIC_LEGAL_CONTACT_ADDRESS=
IMAGE_STORAGE_DRIVER=s3
IMAGE_STORAGE_PUBLIC_BASE_URL=https://cdn.babyloop.example
S3_ENDPOINT=https://REPLACE_WITH_R2_ENDPOINT
S3_REGION=auto
S3_BUCKET=REPLACE_WITH_PRODUCTION_BUCKET
S3_ACCESS_KEY_ID=REPLACE_WITH_SECRET_MANAGER_VALUE
S3_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_MANAGER_VALUE
S3_FORCE_PATH_STYLE=false
RAG_ENABLED=true
RAG_VECTOR_STORE=qdrant
RAG_QDRANT_URL=https://REPLACE_WITH_PRODUCTION_QDRANT
RAG_QDRANT_API_KEY=REPLACE_WITH_SECRET_MANAGER_VALUE
RAG_QDRANT_COLLECTION=babyloop_production_rag_active
RAG_QDRANT_VECTOR_SIZE=3072
RAG_EMBEDDING_PROVIDER=gemini
RAG_EMBEDDING_MODEL=gemini-embedding-2
RAG_CHAT_PROVIDER=gemini
RAG_CHAT_MODEL=gemini-2.5-flash
RAG_REQUIRE_SOURCES=true
RAG_REDIS_ENABLED=true
RAG_REDIS_URL=rediss://REPLACE_WITH_PRODUCTION_REDIS
RAG_REDIS_KEY_PREFIX=babyloop:production:rag
RAG_CACHE_BACKEND=redis
RAG_USAGE_LIMITS_BACKEND=redis
RAG_METRICS_BACKEND=redis
GEMINI_API_KEY=REPLACE_WITH_SECRET_MANAGER_VALUE
GEMINI_ASSISTANT_MODEL=gemini-2.5-flash-lite
GEMINI_LISTING_DRAFT_MODEL=gemini-2.5-flash
GEMINI_MODERATION_SUMMARY_MODEL=gemini-2.5-flash-lite
GEMINI_LISTING_IMAGE_AUTHENTICITY_MODEL=gemini-2.5-flash
LISTING_IMAGE_AUTHENTICITY_PROVIDER=gemini
EMAIL_DELIVERY_MODE=provider
EMAIL_SEND_ENABLED=true
EMAIL_PROVIDER=resend
EMAIL_FROM=no-reply@REPLACE_WITH_VERIFIED_DOMAIN
RESEND_API_KEY=REPLACE_WITH_SECRET_MANAGER_VALUE
RESEND_FROM_EMAIL=no-reply@REPLACE_WITH_VERIFIED_DOMAIN
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_EMAIL_PROVIDER=resend
ASSISTANT_PROVIDER=gemini
AI_LISTING_DRAFT_PROVIDER=gemini
AI_MODERATION_SUMMARY_PROVIDER=gemini
OBSERVABILITY_METRICS_ENABLED=true
OBSERVABILITY_METRICS_TOKEN=REPLACE_WITH_RANDOM_METRICS_TOKEN
OBSERVABILITY_ERROR_WEBHOOK_URL=https://REPLACE_WITH_ERROR_SINK
OBSERVABILITY_ENVIRONMENT=production
HEALTH_REQUIRE_NOTIFICATION_WORKER=true
HEALTH_REQUIRE_CHILD_REMINDER_WORKER=true
HEALTH_FAIL_ON_STALE_NOTIFICATION_CLAIMS=true
NOTIFICATION_WORKER_MAX_STALENESS_SECONDS=300
CHILD_REMINDER_WORKER_MAX_STALENESS_SECONDS=300
NOTIFICATION_PROVIDER_WORKER_ID=production-notification-worker
CHILD_REMINDER_WORKER_ID=production-child-reminder-worker
NOTIFICATION_WORKER_INTERVAL_SECONDS=20
CHILD_REMINDER_WORKER_INTERVAL_SECONDS=60
WORKER_FAILURE_BACKOFF_SECONDS=30
CHILD_REMINDER_PROCESSOR_DRY_RUN=false
CHILD_REMINDER_DELIVERY_CHANNELS=in_app,email,push
BACKUP_ENVIRONMENT=production
BACKUP_OUTPUT_DIR=/var/lib/babyloop/backups
BACKUP_REPLICA_DIR=/mnt/backup-replica
BACKUP_ENCRYPTION_MODE=age
BACKUP_AGE_RECIPIENT=age1REPLACE_WITH_PUBLIC_RECIPIENT
BACKUP_RETENTION_DAYS=30
BACKUP_RETENTION_COUNT=30
BACKUP_RESTORE_SMOKE_EVIDENCE=/var/lib/babyloop/evidence/production-restore-smoke.json
RELEASE_DATABASE_FORWARD_COMPATIBLE=false
MIGRATION_ENVIRONMENT=production

# OAuth and real provider delivery
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_SECRET_MANAGER_VALUE
GOOGLE_REDIRECT_URI=https://api.babyloop.example/api/v1/auth/google/callback
