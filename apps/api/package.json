{
  "name": "@babyloop/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:deps": "pnpm --filter '@babyloop/api^...' build",
    "dev": "pnpm build:deps && pnpm build && node --env-file-if-exists=../../.env.local dist/server.js",
    "rag:ingest": "pnpm exec tsx src/scripts/rag-ingest.ts",
    "child-reminders:process": "pnpm exec tsx src/scripts/process-child-reminders.ts",
    "notifications:process": "pnpm exec tsx src/scripts/process-notification-deliveries.ts",
    "storage:smoke:r2": "node --env-file-if-exists=../../.env.local --import tsx src/scripts/smoke-r2-image-storage.ts",
    "build": "pnpm build:deps && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "pnpm build:deps && tsc -p tsconfig.json --noEmit",
    "notifications:smoke:providers": "pnpm exec tsx src/scripts/smoke-notification-provider-flow.ts",
    "notifications:smoke:marketplace-email": "node --env-file-if-exists=../../.env.local --import tsx src/scripts/smoke-marketplace-email-notifications.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@babyloop/ai-core": "workspace:*",
    "@babyloop/config": "workspace:*",
    "@babyloop/database": "workspace:*",
    "@babyloop/shared": "workspace:*",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^5.2.6",
    "drizzle-orm": "^0.39.0",
    "fastify": "^5.0.0",
    "nodemailer": "^9.0.1",
    "sharp": "^0.35.2",
    "socket.io": "^4.8.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1",
    "@vitest/coverage-v8": "4.1.6",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.22.4",
    "vitest": "^4.1.6"
  }
}
