{
  "name": "@babyloop/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:deps": "pnpm --filter '@babyloop/api^...' build",
    "dev": "pnpm build:deps && pnpm build && node dist/server.js",
    "build": "pnpm build:deps && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "pnpm build:deps && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@babyloop/ai-core": "workspace:*",
    "@babyloop/config": "workspace:*",
    "@babyloop/database": "workspace:*",
    "@babyloop/shared": "workspace:*",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "drizzle-orm": "^0.39.0",
    "fastify": "^5.0.0",
    "socket.io": "^4.8.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.6",
    "socket.io-client": "^4.8.3",
    "vitest": "^4.1.6"
  }
}
