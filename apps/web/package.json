{
  "name": "@babyloop/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:deps": "pnpm --filter '@babyloop/web^...' build",
    "dev": "pnpm build:deps && next dev --port 3000",
    "build": "pnpm build:deps && next build",
    "start": "next start --port 3000",
    "typecheck": "pnpm build:deps && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@babyloop/shared": "workspace:*",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
