# BabyLoop public web
# Copy to apps/web/.env.local for app-specific local overrides.

NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
BABYLOOP_API_BASE_URL=http://localhost:4000

NEXT_PUBLIC_BACKOFFICE_BASE_URL=http://localhost:3001

# Used by metadata, canonical URLs, robots, sitemap, and OpenGraph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BABYLOOP_SITE_URL=http://localhost:3000

# Legal/KVKK public operator details.
# non_commercial_beta: no real payment collection; a public city/country is sufficient.
# commercial_public: a usable public contact address becomes mandatory.
NEXT_PUBLIC_LEGAL_OPERATOR_NAME=BabyLoop Local Development
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=legal@babyloop.local
NEXT_PUBLIC_LEGAL_RELEASE_MODE=non_commercial_beta
NEXT_PUBLIC_LEGAL_COMMERCIAL_ACTIVITY_ENABLED=false
NEXT_PUBLIC_LEGAL_PUBLIC_LOCATION=İstanbul, Türkiye
NEXT_PUBLIC_LEGAL_CONTACT_ADDRESS=
