{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "env": [
        "TEST_DATABASE_URL"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalEnv": [
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "AUTH_SECRET",
    "ALLOW_AUTH_UNAVAILABLE",
    "ASSISTANT_PROVIDER",
    "AI_LISTING_DRAFT_PROVIDER",
    "AI_MODERATION_SUMMARY_PROVIDER",
    "GEMINI_API_KEY",
    "GOOGLE_API_KEY",
    "GEMINI_ASSISTANT_MODEL",
    "GEMINI_LISTING_DRAFT_MODEL",
    "GEMINI_MODERATION_SUMMARY_MODEL",
    "GEMINI_API_ENDPOINT",
    "RAG_ENABLED",
    "RAG_VECTOR_STORE",
    "RAG_QDRANT_URL",
    "RAG_QDRANT_API_KEY",
    "RAG_QDRANT_COLLECTION",
    "RAG_QDRANT_VECTOR_SIZE",
    "RAG_EMBEDDING_PROVIDER",
    "RAG_EMBEDDING_MODEL",
    "RAG_CHAT_PROVIDER",
    "RAG_CHAT_MODEL",
    "RAG_MIN_SCORE",
    "RAG_MAX_CHUNKS",
    "RAG_MAX_SOURCES_PER_DOCUMENT",
    "RAG_MAX_CONTEXT_CHARS",
    "RAG_REQUIRE_SOURCES",
    "OPENAI_API_KEY",
    "OPENAI_ASSISTANT_MODEL",
    "OPENAI_LISTING_DRAFT_MODEL",
    "OPENAI_MODERATION_SUMMARY_MODEL",
    "OPENAI_RESPONSES_ENDPOINT",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "GOOGLE_REDIRECT_URI"
  ]
}
